# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Đề 12: Hệ Thống Quản Lý Nhà Hàng / Order
# ==========================================

# 1. Cơ sở dữ liệu PostgreSQL (Nội bộ Docker, không mở ra ngoài Host)
POSTGRES_DB=restaurant_db
POSTGRES_USER=restaurant_user
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_PORT=5432

# 2. Cổng dịch vụ ứng dụng Node.js (Nội bộ)
APP_PORT=3000
NODE_ENV=production

# 3. Quản trị cơ sở dữ liệu pgAdmin (dùng domain hợp lệ như .com, .vn, không dùng .local)
PGADMIN_DEFAULT_EMAIL=admin@nhahang.com
PGADMIN_DEFAULT_PASSWORD=your_secure_pgadmin_password_here
PGADMIN_PORT=5050

# 4. Cổng Reverse Proxy Nginx (8080 cho HTTP, 443 cho HTTPS)
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=443

# 5. Monitoring & Logging Ports
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
